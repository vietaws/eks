# 31 / 02 Secondary CIDR: every name, CIDR and version used by the scripts and templates.
# Change values HERE only. The scripts render the *.yaml templates (${VAR} placeholders)
# into .rendered/ from these values before every eksctl, helm or kubectl call.
# Bash syntax: KEY=value, no spaces around '='. A value may reference an earlier key: ${CLUSTER_NAME}.

# --- Cluster -------------------------------------------------------------------
CLUSTER_NAME=vietvn-secondary-ctl
REGION=ap-southeast-1
K8S_VERSION=1.37
AZ_1=ap-southeast-1a
AZ_2=ap-southeast-1b

# --- Network -------------------------------------------------------------------
VPC_CIDR=10.100.0.0/24            # /16 to /24 (eksctl limit); eksctl splits it into 8 equal subnets
SERVICE_CIDR=172.20.0.0/16        # Kubernetes Services; must not overlap the VPC CIDRs
# Secondary CIDR for pods. eksctl does NOT associate it with the VPC (its extraCIDRs field only adds a
# control-plane security group rule), so scripts/secondary-cidr.sh associates it and creates the pod subnets.
# Must not overlap any VPC you will peer with (scripts/preflight-cidr.sh checks this account/region).
SECONDARY_CIDR=100.64.0.0/16      # RFC 6598 shared space, recommended by the EKS best-practices guide
POD_SUBNET_1_CIDR=100.64.0.0/20   # pod subnet in AZ_1, must be inside SECONDARY_CIDR
POD_SUBNET_2_CIDR=100.64.16.0/20  # pod subnet in AZ_2, must be inside SECONDARY_CIDR
POD_SUBNET_TAG_KEY=demo           # tag that marks the subnets owned by secondary-cidr.sh
POD_SUBNET_TAG_VALUE=${CLUSTER_NAME}-pods

# --- Node groups (one per stage: <prefix>0, <prefix>1, <prefix>2) ----------------
NODEGROUP_PREFIX=ng-s
INSTANCE_TYPE=t3.medium
NODE_DESIRED=2
NODE_MIN=0
NODE_MAX=3
NODE_VOLUME_SIZE=20               # GiB
MAX_PODS_STAGE1=12                # custom networking on t3.medium: (3-1)*(6-1)+2
MAX_PODS_STAGE2=110               # prefix delegation; managed node groups cap it at 110 below 30 vCPU
WARM_PREFIX_TARGET=1              # stage 2: spare /28 prefixes kept per node

# --- AWS Load Balancer Controller and ALB --------------------------------------
LBC_ROLE_NAME=${CLUSTER_NAME}-lbc
LBC_SERVICE_ACCOUNT=aws-load-balancer-controller
INGRESS_NAME=secondary-cidr-alb
ALB_NAME=${CLUSTER_NAME}-alb      # max 32 characters

# --- Chart versions ------------------------------------------------------------
LBC_CHART_VERSION=3.6.3
