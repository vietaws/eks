# 31 / 01 Cilium overlay: every name, CIDR and version used by the scripts and templates.
# Change values HERE only. The scripts render the *.yaml templates (${VAR} placeholders)
# into .rendered/ from these values before every eksctl, helm or kubectl call.
# Bash syntax: KEY=value, no spaces around '='. A value may reference an earlier key: ${CLUSTER_NAME}.

# --- Cluster -------------------------------------------------------------------
CLUSTER_NAME=vietvn-overlay-ctl
REGION=ap-southeast-1
K8S_VERSION=1.37
AZ_1=ap-southeast-1a
AZ_2=ap-southeast-1b

# --- Network -------------------------------------------------------------------
VPC_CIDR=10.100.0.0/24        # /16 to /24 (eksctl limit); eksctl splits it into 8 equal subnets
SERVICE_CIDR=172.20.0.0/16    # Kubernetes Services; must not overlap VPC_CIDR or POD_CIDR
POD_CIDR=192.168.0.0/16       # Cilium cluster pool; never becomes a VPC CIDR
POD_CIDR_MASK_SIZE=24         # block per node (/24 = 254 pod IPs, enough for MAX_PODS)

# --- Node group ----------------------------------------------------------------
NODEGROUP_NAME=ng-overlay
INSTANCE_TYPE=t3.medium
NODE_DESIRED=2
NODE_MIN=0
NODE_MAX=3
NODE_VOLUME_SIZE=20           # GiB
MAX_PODS=110                  # kubelet maxPods (managed node groups cap it at 110 below 30 vCPU)

# --- AWS Load Balancer Controller and ALB --------------------------------------
LBC_ROLE_NAME=${CLUSTER_NAME}-lbc
LBC_SERVICE_ACCOUNT=aws-load-balancer-controller
INGRESS_NAME=overlay-alb
ALB_NAME=${CLUSTER_NAME}-alb  # max 32 characters

# --- Chart versions ------------------------------------------------------------
CILIUM_VERSION=1.20.5
LBC_CHART_VERSION=3.6.3
